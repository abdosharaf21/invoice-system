# Flask Environment
FLASK_ENV=development

# Security (REQUIRED — set strong values in production)
SECRET_KEY=
JWT_SECRET_KEY=
# JWT lifetimes in seconds (defaults: 3600 / 2592000 = 30 days). Shorten the
# access token in production if desired.
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=invoice_system
DB_USER=invoice_app
DB_PASSWORD=your_database_password
DB_POOL_NAME=invoice_pool
DB_POOL_SIZE=5

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5001

# Production static serving (optional single-box mode, SERVE_STATIC=true only
# in ProductionConfig). Must contain index.html and an assets/ subtree.
# FRONTEND_DIST=/opt/e-invoice/frontend

# CORS — comma-separated list of allowed origins
# List the exact public origin(s) the browser will call, e.g.
#   CORS_ORIGINS=https://invoice.example.com
# Never use "*" — it cannot be combined with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Append LAN-IP variants of localhost origins so a phone/PC on the
# same network can reach the API during development. ProductionConfig
# defaults this to false; leave it off for internet-facing deployments.
CORS_EXPAND_LAN=true

# Rate limiting (login 5/min, refresh 30/min, password 5/min, email 10/min,
# file upload 5/min). Keep enabled in production.
RATE_LIMIT_ENABLED=true
# Client IP exemption list. In development (direct access) loopback is
# exempted. ProductionConfig defaults this to EMPTY: with Nginx in front,
# loopback exemptions would exempt every request (all arrive from 127.0.0.1).
# RATE_LIMIT_EXEMPT_IPS=

# Security headers — config-driven per environment
SECURITY_HEADERS_ENABLED=true
# CSP must be off while the Vite dev server (HMR websocket) serves the SPA.
# Set CSP_ENABLED=true in production and keep CSP_POLICY in sync with the app.
CSP_ENABLED=false
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'
# Enable ONLY when the server is reachable over HTTPS
HSTS_ENABLED=false

# Logging
LOG_LEVEL=INFO

# --- Outbound email (Phase 7) -------------------------------------------------
# EMAIL_ENABLED=true is required to actually send notifications. When enabled,
# EMAIL_HOST, EMAIL_PORT and EMAIL_FROM are mandatory and validated at startup.
# Never commit real credentials; EMAIL_PASSWORD must stay out of version control.
EMAIL_ENABLED=false
# "smtp" (generic SMTP) or "gmail". For Gmail set EMAIL_HOST=smtp.gmail.com.
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Notifications go to the taxpayers/counterparties of a reconciliation run
# (emails captured during invoice import). No internal-role configuration here.
